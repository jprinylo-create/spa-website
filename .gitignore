# Starting Point website repo — publish ONLY the site file.
# Everything in this folder is ignored by default...
/*
# ...except what the live site actually needs:
!/.gitignore
!/.vercelignore
!/index.html
!/about.html
!/advisory.html
!/testimonials.html
!/vip.html
!/monthly.html
!/referral.html
!/elite.html
# Brand image assets used by the pages. Narrow on purpose: re-ignore the
# contents of each directory, then allow ONLY the two derived logo files.
# The source logos/photos in assets/img stay private.
!/assets/
/assets/*
!/assets/img/
/assets/img/*
!/assets/img/spa-logo-horizontal-white.png
!/assets/img/spa-compass-white.png
!/assets/img/jp-portrait.webp
# Reference documents kept with the project (excluded from deploy via .vercelignore):
!/referral/
!/referral/SPA-referral-quick-reference.pdf
